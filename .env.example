# Envío del formulario.
# Puedes usar Web3Forms, Formspree, o las dos. Si ambas existen, se usa Web3Forms.
# En GitHub Pages, configura estas variables en:
# Settings → Secrets and variables → Actions → Variables.
# También puedes pegar la clave/endpoint directamente en src/lib/site.ts.

# Web3Forms: https://web3forms.com
VITE_WEB3FORMS_KEY=

# Formspree: https://formspree.io (endpoint completo)
VITE_FORMSPREE_ENDPOINT=
